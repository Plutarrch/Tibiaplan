---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Sidebar from "../components/Sidebar.astro";
import Footer from "../components/Footer.astro";
import CharacterSheet from "../components/CharacterSheet.astro";
import TrainingTab from "../components/tabs/TrainingTab.astro";
import LootSplitTab from "../components/tabs/LootSplitTab.astro";
import ImbuementsTab from "../components/tabs/ImbuementsTab.astro";
import CharacterSearchTab from "../components/tabs/CharacterSearchTab.astro";
---

<Layout>
  <Header />

  <div class="mx-auto max-w-7xl px-4 pt-4">
    <div
      class="grid h-[90px] place-items-center rounded-md border border-dashed border-border-subtle bg-bg-sunken text-[10px] uppercase tracking-[0.15em] text-text-tertiary"
      aria-hidden="true"
    >
      Banner ad
    </div>
  </div>

  <div x-data="tabsControl">
    <div x-data="lootTab">
      <!--
        Top section: 2-col grid with main column (Character Sheet + tabs nav
        + the Training/Loot Split tab content) and the sidebar (ads, featured
        resellers, hunt history). Standard layout.
      -->
      <div
        class="mx-auto grid max-w-7xl grid-cols-1 items-stretch gap-6 px-4 py-6 lg:grid-cols-[minmax(0,1fr)_300px]"
      >
        <main class="min-w-0">
          <CharacterSheet />

          <div class="mt-6">
            <!--
              Tab nav with an icon sprite to the left of each label. Sprite
              size matches the header widgets (Rashid / Creature / Boss):
              h-9 w-9 = 36px. onerror falls back to text-only so partial
              sprite drops never break the tab UI.
            -->
            <nav class="flex flex-wrap gap-2" aria-label="Tools">
              <button
                type="button"
                class="flex items-center gap-2 rounded px-3 py-2 text-[12px] transition-colors"
                :class="active === 'training' ? 'is-active' : 'border border-border-subtle bg-bg-surface text-text-secondary hover:border-border-emphasis hover:text-text-primary'"
                @click="setActive('training')"
              >
                <img
                  src="/sprites/tabs/training.gif"
                  alt=""
                  class="h-9 w-9 object-contain"
                  loading="lazy"
                  decoding="async"
                  onerror="this.style.display='none'"
                />
                <span>Training</span>
              </button>
              <button
                type="button"
                class="flex items-center gap-2 rounded px-3 py-2 text-[12px] transition-colors"
                :class="active === 'loot' ? 'is-active' : 'border border-border-subtle bg-bg-surface text-text-secondary hover:border-border-emphasis hover:text-text-primary'"
                @click="setActive('loot')"
              >
                <img
                  src="/sprites/tabs/loot.webp"
                  alt=""
                  class="h-9 w-9 object-contain"
                  loading="lazy"
                  decoding="async"
                  onerror="this.style.display='none'"
                />
                <span>Loot Split</span>
              </button>
              <button
                type="button"
                class="flex items-center gap-2 rounded px-3 py-2 text-[12px] transition-colors"
                :class="active === 'imbuements' ? 'is-active' : 'border border-border-subtle bg-bg-surface text-text-secondary hover:border-border-emphasis hover:text-text-primary'"
                @click="setActive('imbuements')"
              >
                <img
                  src="/sprites/tabs/imbuement.gif"
                  alt=""
                  class="h-9 w-9 object-contain"
                  loading="lazy"
                  decoding="async"
                  onerror="this.style.display='none'"
                />
                <span>Imbuements</span>
              </button>
              <button
                type="button"
                class="flex items-center gap-2 rounded px-3 py-2 text-[12px] transition-colors"
                :class="active === 'character-search' ? 'is-active' : 'border border-border-subtle bg-bg-surface text-text-secondary hover:border-border-emphasis hover:text-text-primary'"
                @click="setActive('character-search')"
              >
                <img
                  src="/sprites/tabs/character-search.gif"
                  alt=""
                  class="h-9 w-9 object-contain"
                  loading="lazy"
                  decoding="async"
                  onerror="this.style.display='none'"
                />
                <span>Character Search</span>
              </button>
            </nav>

            <div class="mt-4">
              <div x-show="active === 'training'" x-cloak>
                <TrainingTab />
              </div>

              <div x-show="active === 'loot'" x-cloak>
                <LootSplitTab />
              </div>

              <div x-show="active === 'character-search'" x-cloak>
                <CharacterSearchTab />
              </div>

              <!--
                Imbuements header: lives in the main column tab-content area
                so it shares the SAME width and SAME mt-4 gap from the tabs
                as Training Calculator and Loot Split. The full-width sections
                (Combat / Skill Boost / Protection) render below the [main +
                sidebar] grid — together they form a natural L-step:
                narrow header on top, wide sections below.
              -->
              <div x-show="active === 'imbuements'" x-cloak>
                <div class="rounded-md border border-border-subtle bg-bg-surface p-6">
                  <div class="flex flex-wrap items-baseline justify-between gap-3">
                    <h2 class="text-[14px] font-medium tracking-wide text-text-primary">Imbuements</h2>
                    <p class="text-[10px] uppercase tracking-[0.1em] text-text-tertiary">
                      Tap a tier to see its materials and cost
                    </p>
                  </div>
                  <p class="mt-2 text-[11px] leading-relaxed text-text-secondary">
                    Each imbuement lasts 20 hours per use and applies to one item slot. Tier 3
                    requires completing the relevant boss quest the first time on each character.
                    <a
                      href="/boss-list"
                      class="text-accent-violet underline-offset-2 hover:underline"
                    >(See Boss list)</a>
                  </p>
                </div>
              </div>
            </div>
          </div>
        </main>

        <Sidebar />
      </div>

      <!--
        Imbuements sections (Combat / Skill Boost / Protection): full-width
        row below the [main + sidebar] grid. lg:-mt-4 trims the dead space
        between the Imbuements header card (in main column) and the sections
        card. The combo of compact Drome card + AD 300×200 (instead of 250)
        already shrinks the sidebar enough that main is the taller column;
        this -16px just absorbs the residual breathing room.
      -->
      <div
        x-show="active === 'imbuements'"
        x-cloak
        class="mx-auto max-w-7xl px-4 pb-6 lg:-mt-4"
      >
        <ImbuementsTab />
      </div>
    </div>
  </div>

  <Footer />
</Layout>
