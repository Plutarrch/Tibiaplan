---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Sidebar from "../components/Sidebar.astro";
import Footer from "../components/Footer.astro";
import AdSlot from "../components/AdSlot.astro";
import CharacterSheet from "../components/CharacterSheet.astro";
import TrainingTab from "../components/tabs/TrainingTab.astro";
import OfflineTrainingTab from "../components/tabs/OfflineTrainingTab.astro";
import LootSplitTab from "../components/tabs/LootSplitTab.astro";
import ImbuementsTab from "../components/tabs/ImbuementsTab.astro";
import CharacterSearchTab from "../components/tabs/CharacterSearchTab.astro";

// JSON-LD: a @graph with two entities sharing the same URL. WebSite tells
// Google "this is the canonical site for TibiaPlan"; WebApplication tells
// it "this is a free GameApplication" so the SERP can show the "Free" badge
// and the feature list as sitelinks. Both are required because they answer
// different questions (site identity vs. app classification).
const SITE_URL = "https://tibiaplan.com";
const SITE_DESCRIPTION =
  "Free Tibia calculators and tools: training, imbuements, loot split, exercise weapons, and more. Fast, mobile-friendly, no ads.";

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": `${SITE_URL}/#website`,
      name: "TibiaPlan",
      url: SITE_URL,
      description: SITE_DESCRIPTION,
      inLanguage: "en",
    },
    {
      "@type": "WebApplication",
      "@id": `${SITE_URL}/#webapp`,
      name: "TibiaPlan",
      url: SITE_URL,
      description: SITE_DESCRIPTION,
      applicationCategory: "GameApplication",
      operatingSystem: "Any",
      browserRequirements: "Requires JavaScript",
      offers: {
        "@type": "Offer",
        price: "0",
        priceCurrency: "USD",
      },
      featureList: [
        "Training Calculator",
        "Loot Split",
        "Imbuements Reference",
        "Character Search",
      ],
    },
  ],
};
---

<Layout
  title="TibiaPlan - Free Tibia Calculators, Loot Split & Imbuements"
  description="Free Tibia calculators and tools: training, imbuements, loot split, exercise weapons, and more. Fast, mobile-friendly, no ads."
  keywords={["tibia tools", "tibia calculator", "tibia fansite", "tibia training calculator", "tibia loot split", "tibia imbuements"]}
  structuredData={structuredData}
>
  <Header />

  <div class="mx-auto max-w-7xl px-4 pt-4">
    <AdSlot height={90} fullWidth />
  </div>

  <div x-data="tabsControl">
    <div x-data="lootTab">
      <!--
        Top section: 2-col grid with main column (Character Sheet + tabs nav
        + the Training/Loot Split tab content) and the sidebar (ads, featured
        resellers, hunt history). Standard layout.
      -->
      <div
        class="mx-auto grid max-w-7xl grid-cols-1 items-stretch gap-6 px-4 py-6 lg:grid-cols-[minmax(0,1fr)_300px]"
      >
        <main class="min-w-0">
          <CharacterSheet />

          <div class="mt-6">
            <!--
              Tab nav with an icon sprite to the left of each label. Sprite
              size matches the header widgets (Rashid / Creature / Boss):
              h-9 w-9 = 36px. onerror falls back to text-only so partial
              sprite drops never break the tab UI.
            -->
            <nav class="flex flex-wrap gap-2" aria-label="Tools">
              <button
                type="button"
                class="flex items-center gap-2 rounded px-3 py-2 text-[12px] transition-colors"
                :class="active === 'training' ? 'is-active' : 'border border-border-subtle bg-bg-surface text-text-secondary hover:border-border-emphasis hover:text-text-primary'"
                @click="setActive('training')"
              >
                <img
                  src="/sprites/tabs/training.gif"
                  alt=""
                  class="h-9 w-9 object-contain"
                  loading="lazy"
                  decoding="async"
                  onerror="this.style.display='none'"
                />
                <span>Training</span>
              </button>
              <button
                type="button"
                class="flex items-center gap-2 rounded px-3 py-2 text-[12px] transition-colors"
                :class="active === 'loot' ? 'is-active' : 'border border-border-subtle bg-bg-surface text-text-secondary hover:border-border-emphasis hover:text-text-primary'"
                @click="setActive('loot')"
              >
                <img
                  src="/sprites/tabs/loot.webp"
                  alt=""
                  class="h-9 w-9 object-contain"
                  loading="lazy"
                  decoding="async"
                  onerror="this.style.display='none'"
                />
                <span>Loot Split</span>
              </button>
              <button
                type="button"
                class="flex items-center gap-2 rounded px-3 py-2 text-[12px] transition-colors"
                :class="active === 'imbuements' ? 'is-active' : 'border border-border-subtle bg-bg-surface text-text-secondary hover:border-border-emphasis hover:text-text-primary'"
                @click="setActive('imbuements')"
              >
                <img
                  src="/sprites/tabs/imbuement.gif"
                  alt=""
                  class="h-9 w-9 object-contain"
                  loading="lazy"
                  decoding="async"
                  onerror="this.style.display='none'"
                />
                <span>Imbuements</span>
              </button>
              <button
                type="button"
                class="flex items-center gap-2 rounded px-3 py-2 text-[12px] transition-colors"
                :class="active === 'character-search' ? 'is-active' : 'border border-border-subtle bg-bg-surface text-text-secondary hover:border-border-emphasis hover:text-text-primary'"
                @click="setActive('character-search')"
              >
                <img
                  src="/sprites/tabs/character-search.gif"
                  alt=""
                  class="h-9 w-9 object-contain"
                  loading="lazy"
                  decoding="async"
                  onerror="this.style.display='none'"
                />
                <span>Character Search</span>
              </button>
            </nav>

            <div class="mt-4">
              <!--
                Training tab now has two sub-tabs inside a single card:
                Exercise Weapons (original calc) and Offline Training (new,
                Phase 1 UI shell). Tab bar lives in the card header with a
                bottom divider; the active tab gets a violet underline +
                bold text. Sub-tab state is local Alpine — short-lived, no
                persistence. Lift to tabsControl later if needed.
              -->
              <div
                x-show="active === 'training'"
                x-cloak
                x-data="{ trainingSub: 'exercise' }"
                class="overflow-hidden rounded-md border border-border-subtle bg-bg-surface"
              >
                <nav
                  class="flex border-b border-border-subtle"
                  aria-label="Training type"
                >
                  <button
                    type="button"
                    @click="trainingSub = 'exercise'"
                    class="flex flex-1 items-center justify-center gap-2 px-5 py-3 text-[12px] font-medium transition-colors"
                    :class="trainingSub === 'exercise' ? 'bg-accent-violet text-bg-primary' : 'text-text-secondary hover:bg-bg-sunken hover:text-text-primary'"
                  >
                    <img
                      src="/sprites/tabs/exercise-weapon.gif"
                      alt=""
                      class="h-7 w-7 object-contain"
                      loading="lazy"
                      decoding="async"
                      onerror="this.style.display='none'"
                    />
                    <span>Exercise Weapons</span>
                  </button>
                  <button
                    type="button"
                    @click="trainingSub = 'offline'"
                    class="flex flex-1 items-center justify-center gap-2 border-l border-border-subtle px-5 py-3 text-[12px] font-medium transition-colors"
                    :class="trainingSub === 'offline' ? 'bg-accent-violet text-bg-primary' : 'text-text-secondary hover:bg-bg-sunken hover:text-text-primary'"
                  >
                    <img
                      src="/sprites/tabs/skill-trainer.gif"
                      alt=""
                      class="h-7 w-7 object-contain"
                      loading="lazy"
                      decoding="async"
                      onerror="this.style.display='none'"
                    />
                    <span>Offline Training</span>
                  </button>
                </nav>

                <div class="p-6">
                  <div x-show="trainingSub === 'exercise'" x-cloak>
                    <TrainingTab />
                  </div>
                  <div x-show="trainingSub === 'offline'" x-cloak>
                    <OfflineTrainingTab />
                  </div>
                </div>
              </div>

              <div x-show="active === 'loot'" x-cloak>
                <LootSplitTab />
              </div>

              <div x-show="active === 'character-search'" x-cloak>
                <CharacterSearchTab />
              </div>

              <!--
                Imbuements header: lives in the main column tab-content area
                so it shares the SAME width and SAME mt-4 gap from the tabs
                as Training Calculator and Loot Split. The full-width sections
                (Combat / Skill Boost / Protection) render below the [main +
                sidebar] grid — together they form a natural L-step:
                narrow header on top, wide sections below.
              -->
              <div x-show="active === 'imbuements'" x-cloak>
                <div class="rounded-md border border-border-subtle bg-bg-surface p-6">
                  <div class="flex flex-wrap items-baseline justify-between gap-3">
                    <h2 class="text-[14px] font-medium tracking-wide text-text-primary">Imbuements</h2>
                    <p class="text-[10px] uppercase tracking-[0.1em] text-text-tertiary">
                      Tap a tier to see its materials and cost
                    </p>
                  </div>
                  <p class="mt-2 text-[11px] leading-relaxed text-text-secondary">
                    Each imbuement lasts 20 hours per use and applies to one item slot. Tier 3
                    requires completing the relevant boss quest the first time on each character.
                    <a
                      href="/boss-list"
                      class="text-accent-violet underline-offset-2 hover:underline"
                    >(See Boss list)</a>
                  </p>
                </div>
              </div>
            </div>
          </div>
        </main>

        <Sidebar />
      </div>

      <!--
        Imbuements sections (Combat / Skill Boost / Protection): full-width
        row below the [main + sidebar] grid. lg:-mt-4 trims the dead space
        between the Imbuements header card (in main column) and the sections
        card. The combo of compact Drome card + AD 300×200 (instead of 250)
        already shrinks the sidebar enough that main is the taller column;
        this -16px just absorbs the residual breathing room.
      -->
      <div
        x-show="active === 'imbuements'"
        x-cloak
        class="mx-auto max-w-7xl px-4 pb-6 lg:-mt-4"
      >
        <ImbuementsTab />
      </div>
    </div>
  </div>

  <Footer />
</Layout>
