const structuredData = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: "Tibia Death Penalty Guide: Exact EXP Loss in 2026",
  description:
    "Exact math behind dying in Tibia: MeL formula, promotion -30%, blessings -8% each, skulls, Twist of Fate, item drop chances, unfair-fight reduction.",
  datePublished: PUBLISHED,
  dateModified: MODIFIED,
  author: { "@type": "Organization", name: "TibiaPlan" },
  publisher: {
    "@type": "Organization",
    name: "TibiaPlan",
    url: "https://tibiaplan.com",
  },
  mainEntityOfPage: { "@type": "WebPage", "@id": URL },
