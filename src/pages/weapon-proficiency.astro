                        </div>
                      </template>
                      <!-- Shielding -->
                      <template x-if="weaponSummaryB?.stats.shielding.hasBase || weaponSummaryB?.stats.shielding.hasBonus">
                        <div class="flex items-center justify-between gap-2">
                          <span class="text-text-tertiary">Shielding</span>
                          <span class="inline-flex items-center gap-1">
                            <span
                              :class="weaponSummaryB.stats.shielding.hasBonus ? 'font-semibold text-success' : 'font-medium text-text-primary'"
                              :title="weaponSummaryB.stats.shielding.hasBonus ? `${weaponSummaryB.stats.shielding.base ?? 0} base + ${weaponSummaryB.stats.shielding.bonus} perk` : ''"
                              x-text="`+${weaponSummaryB.stats.shielding.total}`"
                            ></span>
                            <span x-show="compareDiffStat('shielding','B') === 1" class="text-[10px] leading-none text-success" aria-hidden="true">&#8593;</span>
                            <span x-show="compareDiffStat('shielding','B') === -1" class="text-[10px] leading-none text-danger" aria-hidden="true">&#8595;</span>
                          </span>
                        </div>
                      </template>
                      <!-- Damage (wand/rod native, no perk sums). Sits
                           in a single column like every other stat row —
                           the range + element read fine at this width. -->
                      <template x-if="weaponSummaryB?.native.damageRange">
                        <div class="flex items-center justify-between gap-2">
                          <span class="text-text-tertiary">Dmg</span>
                          <span class="font-medium text-text-primary">
                            <span x-text="weaponSummaryB.native.damageRange"></span>
                            <span class="text-text-tertiary" x-text="weaponSummaryB.native.damageType"></span>
                          </span>
                        </div>
                      </template>
                      <!-- Mana cost -->
                      <template x-if="weaponSummaryB?.native.manaCost != null">
                        <div class="flex items-center justify-between gap-2">
                          <span class="text-text-tertiary">Mana</span>
                          <span class="inline-flex items-center gap-1">
                            <span class="font-medium text-text-primary" x-text="weaponSummaryB.native.manaCost"></span>
                            <span x-show="compareDiffNative('manaCost','B') === 1" class="text-[10px] leading-none text-success" aria-hidden="true">&#8593;</span>
                            <span x-show="compareDiffNative('manaCost','B') === -1" class="text-[10px] leading-none text-danger" aria-hidden="true">&#8595;</span>
                          </span>
                        </div>
                      </template>
                      <!-- Imbue slots -->
                      <template x-if="weaponSummaryB?.native.imbueSlots != null">
                        <div class="flex items-center justify-between gap-2">
                          <span class="text-text-tertiary">Imbues</span>
                          <span class="inline-flex items-center gap-1">
                            <span class="font-medium text-text-primary" x-text="weaponSummaryB.native.imbueSlots"></span>
                            <span x-show="compareDiffNative('imbueSlots','B') === 1" class="text-[10px] leading-none text-success" aria-hidden="true">&#8593;</span>
                            <span x-show="compareDiffNative('imbueSlots','B') === -1" class="text-[10px] leading-none text-danger" aria-hidden="true">&#8595;</span>
                          </span>
                        </div>
                      </template>
                      <!-- Element magic level bonuses (only when > 0). -->
                      <template x-for="el in ['holyMagicLevel','iceMagicLevel','earthMagicLevel','energyMagicLevel','fireMagicLevel','deathMagicLevel','healingMagicLevel']" :key="el">
                        <template x-if="weaponSummaryB?.stats[el].hasBase || weaponSummaryB?.stats[el].hasBonus">
                          <div class="flex items-center justify-between gap-2">
                            <span class="text-text-tertiary" x-text="({holyMagicLevel:'Holy Magic Level',iceMagicLevel:'Ice Magic Level',earthMagicLevel:'Earth Magic Level',energyMagicLevel:'Energy Magic Level',fireMagicLevel:'Fire Magic Level',deathMagicLevel:'Death Magic Level',healingMagicLevel:'Healing Magic Level'})[el]"></span>
                            <span class="inline-flex items-center gap-1">
                              <span
                                :class="weaponSummaryB.stats[el].hasBonus ? 'font-semibold text-success' : 'font-medium text-text-primary'"
                                :title="weaponSummaryB.stats[el].hasBonus ? `${weaponSummaryB.stats[el].base ?? 0} base + ${weaponSummaryB.stats[el].bonus} perk` : ''"
                                x-text="`+${weaponSummaryB.stats[el].total}`"
                              ></span>
                              <span x-show="compareDiffStat(el,'B') === 1" class="text-[10px] leading-none text-success" aria-hidden="true">&#8593;</span>
                              <span x-show="compareDiffStat(el,'B') === -1" class="text-[10px] leading-none text-danger" aria-hidden="true">&#8595;</span>
                            </span>
                          </div>
                        </template>
                      </template>
                    </div>

                    <!--
                      Bestiary bonuses. Same family sums across picks
                      (e.g. two +3% Bird perks show as one "+6%" row);
                      the "×N" chip + tooltip breakdown appears when
                      more than one perk contributed to that family.
                    -->
                    <template x-if="weaponSummaryB?.bestiary.length">
                      <div class="mt-3 border-t border-border-subtle pt-3">
                        <p class="mb-1 text-[9px] uppercase tracking-wider text-text-tertiary">Bestiary</p>
                        <ul class="flex flex-wrap gap-x-4 gap-y-1 text-[10px] text-text-secondary">
                          <template x-for="b in weaponSummaryB.bestiary" :key="b.family">
                            <li :title="b.count > 1 ? b.tooltipParts.join(', ') : ''">
                              Bonus Dmg — <span class="text-text-primary" x-text="b.family"></span>
                              <span
                                :class="b.count > 1 ? 'font-semibold text-success' : 'text-text-primary'"
                                x-text="`+${b.totalPct}%`"
                              ></span>
                              <template x-if="b.count > 1">
                                <span class="ml-0.5 text-[9px] text-text-tertiary" x-text="`×${b.count}`"></span>
                              </template>
                            </li>
                          </template>
                        </ul>
                      </div>
                    </template>

                    <!--
                      Generic bonus effects — crit%, scaling, on-kill,
                      on-hit, cooldown, mana leech, boss/sinister, etc.
                      Effects with the same shape collapse into a single
                      summed row; hover the row to see the individual
                      picks that contributed.
                    -->
                    <template x-if="weaponSummaryB?.bonusEffects.length">
                      <div class="mt-3 border-t border-border-subtle pt-3">
                        <p class="mb-1 text-[9px] uppercase tracking-wider text-text-tertiary">Bonus Effects</p>
                        <ul class="space-y-0.5 text-[10px] text-text-secondary">
                          <template x-for="line in weaponSummaryB.bonusEffects" :key="line.display">
                            <li :title="line.count > 1 ? line.tooltipParts.join(', ') : ''">
                              <template x-if="line.valueDisplay">
                                <span
                                  :class="line.count > 1 ? 'font-semibold text-success' : 'text-text-primary'"
                                  x-text="line.valueDisplay"
                                ></span>
                              </template>
                              <span x-text="line.valueDisplay ? ' ' + line.label : line.label"></span>
                              <template x-if="line.count > 1">
                                <span class="ml-1 text-[9px] text-text-tertiary" x-text="`×${line.count}`"></span>
                              </template>
                            </li>
                          </template>
                        </ul>
                      </div>
                    </template>

                    <!-- Spell augments grouped by spell (same collapse
                         rule per spell). -->
                    <template x-if="weaponSummaryB?.spellAugments.length">
                      <div class="mt-3 border-t border-border-subtle pt-3">
                        <p class="mb-1 text-[9px] uppercase tracking-wider text-text-tertiary">Spell Augments</p>
                        <div class="space-y-1.5">
                          <template x-for="aug in weaponSummaryB.spellAugments" :key="aug.spell">
                            <div class="text-[10px]">
                              <p class="text-text-primary" x-text="aug.spell"></p>
                              <ul class="ml-3 space-y-0.5 text-text-secondary">
                                <template x-for="eff in aug.effects" :key="eff.display">
                                  <li :title="eff.count > 1 ? eff.tooltipParts.join(', ') : ''">
                                    <template x-if="eff.valueDisplay">
                                      <span
                                        :class="eff.count > 1 ? 'font-semibold text-success' : 'text-text-primary'"
                                        x-text="eff.valueDisplay"
                                      ></span>
                                    </template>
                                    <span x-text="eff.valueDisplay ? ' ' + eff.label : eff.label"></span>
                                    <template x-if="eff.count > 1">
                                      <span class="ml-1 text-[9px] text-text-tertiary" x-text="`×${eff.count}`"></span>
                                    </template>
                                  </li>
                                </template>
                              </ul>
                            </div>
                          </template>
                        </div>
                      </div>
                    </template>
                  </article>
                  </template>
        </div>
      </template>

      <!--
        ============ SHAPE PICKER MODAL ============
        Overlay + centered card. Fires when the Shape button is clicked
        for either slot; the store holds `shapeModalSlot` + `shapeModalLevel`
        so the modal knows which weapon+level to write to on Apply.
        Backdrop click and Escape close without applying.
      -->
      <template x-if="shapeModalSlot !== null">
        <div
          class="fixed inset-0 z-50 flex items-center justify-center bg-black/70 p-4"
          @click.self="closeShapeModal()"
          @keydown.escape.window="closeShapeModal()"
        >
          <div class="flex max-h-[85vh] w-full max-w-3xl flex-col overflow-hidden rounded-md border border-border-emphasis bg-bg-surface shadow-2xl shadow-black/60">
            <!-- Header -->
            <div class="flex items-center justify-between border-b border-border-subtle px-4 py-3">
              <div>
                <p class="text-[9px] uppercase tracking-wider text-text-tertiary">
                  Shape Perk — Slot <span x-text="shapeModalSlot"></span> · Level <span x-text="shapeModalLevel"></span>
                </p>
                <p class="mt-0.5 text-[13px] font-medium text-text-primary">
                  Choose a replacement perk
                </p>
              </div>
              <button
                type="button"
                @click="closeShapeModal()"
                title="Cancel"
                aria-label="Cancel"
                class="grid h-7 w-7 place-items-center rounded border border-border-subtle bg-bg-sunken text-text-secondary transition-colors hover:border-danger-red hover:text-danger-red"
              >
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="h-3.5 w-3.5" aria-hidden="true">
                  <path d="M5.28 4.22a.75.75 0 0 0-1.06 1.06L8.94 10l-4.72 4.72a.75.75 0 1 0 1.06 1.06L10 11.06l4.72 4.72a.75.75 0 1 0 1.06-1.06L11.06 10l4.72-4.72a.75.75 0 0 0-1.06-1.06L10 8.94 5.28 4.22Z" />
                </svg>
              </button>
            </div>

            <!-- Search -->
            <div class="border-b border-border-subtle px-4 py-2">
              <input
                type="text"
                :value="shapeModalSearch"
                @input="shapeModalSearch = $event.target.value"
                placeholder="Search perks..."
                class="w-full rounded border border-border-subtle bg-bg-sunken px-3 py-1.5 text-[12px] text-text-primary placeholder:text-text-tertiary focus:border-accent-violet focus:outline-none"
              />
            </div>

            <!--
              Options grid — scrollable so the modal height stays bounded
              even with the full ~64-perk list. Selected option gets the
              violet ring; click applies via bottom Swap button.
            -->
            <div class="flex-1 overflow-y-auto p-3">
              <ul class="flex flex-col gap-2">
                <template x-for="opt in shapeModalOptions" :key="opt.id">
                  <li>
                    <button
                      type="button"
                      @click="shapeModalSelectedId = opt.id"
                      class="flex w-full items-center gap-4 rounded border p-3 text-left transition-colors"
                      :class="shapeModalSelectedId === opt.id
                        ? 'border-accent-violet bg-accent-violet/10'
                        : 'border-border-subtle bg-bg-sunken hover:border-accent-violet/60'"
                    >
                      <div class="grid h-14 w-14 shrink-0 place-items-center rounded border border-border-subtle bg-bg-sunken">
                        <img
                          :src="`/sprites/perks/${opt.icon}`"
                          :alt="opt.name"
                          class="h-full w-full object-contain p-1"
                          style="image-rendering: pixelated;"
                          loading="lazy"
                          decoding="async"
                        />
                      </div>
                      <div class="min-w-0 flex-1">
                        <p class="truncate text-[13px] font-medium text-text-primary" x-text="opt.name"></p>
                        <p class="mt-1 text-[11px] leading-snug text-text-secondary" x-text="opt.rank10"></p>
                      </div>
                    </button>
                  </li>
                </template>
                <template x-if="shapeModalOptions.length === 0">
                  <li class="col-span-full px-2 py-6 text-center text-[11px] text-text-tertiary">
                    No matches. Try a different search.
                  </li>
                </template>
              </ul>
            </div>

            <!-- Footer actions -->
            <div class="flex items-center justify-between border-t border-border-subtle px-4 py-3">
              <p class="text-[10px] text-text-tertiary">
                <span x-text="shapeModalOptions.length"></span> compatible perks
              </p>
              <div class="flex gap-2">
                <button
                  type="button"
                  @click="closeShapeModal()"
                  class="rounded border border-border-subtle bg-bg-sunken px-4 py-1.5 text-[11px] font-medium uppercase tracking-wider text-text-secondary transition-colors hover:border-border-emphasis hover:text-text-primary"
                >
                  Cancel
                </button>
                <button
                  type="button"
                  :disabled="!shapeModalSelectedId"
                  @click="applyShapeSelection()"
                  class="rounded border border-accent-violet bg-accent-violet/20 px-4 py-1.5 text-[11px] font-medium uppercase tracking-wider text-accent-violet transition-colors hover:bg-accent-violet/30 disabled:cursor-not-allowed disabled:opacity-40 disabled:hover:bg-accent-violet/20"
                >
                  Swap
                </button>
              </div>
            </div>
          </div>
        </div>
      </template>

    </div>

  </main>

  <Footer />
</Layout>
