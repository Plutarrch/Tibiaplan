---
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "TibiaPlan",
  description = "A fast, mobile-friendly Tibia helper site. Training calculator, loot split, imbuements — share one character profile across every tool.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/png" href="/TibiaPlanLogo.png" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <title>{title}</title>
    <ClientRouter />
  </head>
  <body class="min-h-screen bg-bg-primary text-text-primary antialiased">
    <slot />

    <script>
      import "../lib/alpine";
    </script>
  </body>
</html>
