---
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";
import SEO from "../components/SEO.astro";
import StructuredData from "../components/StructuredData.astro";

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
  keywords?: string[];
  noindex?: boolean;
  structuredData?: Record<string, unknown>;
}

const {
  title = "TibiaPlan - Free Tibia Calculators, Loot Split & Imbuements",
  description = "Free Tibia calculators and tools: training, imbuements, loot split, exercise weapons, and more. Fast, mobile-friendly, no ads.",
  canonical,
  ogImage,
  keywords,
  noindex,
  structuredData,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/png" href="/TibiaPlanLogo.png" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <SEO
      title={title}
      description={description}
      canonical={canonical}
      ogImage={ogImage}
      keywords={keywords}
      noindex={noindex}
    />
    {structuredData && <StructuredData data={structuredData} />}
    <ClientRouter />
  </head>
  <body class="min-h-screen bg-bg-primary text-text-primary antialiased">
    <slot />

    <script>
      import "../lib/alpine";
    </script>
  </body>
</html>
