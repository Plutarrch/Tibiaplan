---
/**
 * Training tab wrapper. Renders 1 to MAX_SLOTS (3) independent
 * TrainingCalcSlot instances so the user can compare training plans
 * across characters at a glance. Owner scenario: "I have a paladin,
 * a monk and a druid — which one is fastest to level?".
 *
 * The primary slot is always visible. Slots 2 and 3 are opt-in via the
 * "Add another calculator" button below. Each slot has its own vocation,
 * skill, inputs, modifiers, and results (fully decoupled — see
 * trainingSlots.ts and trainingTab.ts for the state model).
 *
 * The single "Read guide →" link lives here in the wrapper so it
 * doesn't repeat inside every slot card.
 */
import TrainingCalcSlot from "./TrainingCalcSlot.astro";
---

<div x-data="trainingSlots">
  <!-- Wrapper header — one title + one guide link for the whole tab.
       Individual slots don't repeat this since they'd stack visually. -->
  <div class="mb-4 flex items-center justify-between gap-4">
    <h2 class="text-[14px] font-medium tracking-wide text-text-primary">Training Calculator</h2>
    <a
      href="/guides/tibia-exercise-weapons"
      class="text-[10px] text-text-tertiary transition-colors hover:text-accent-violet"
    >
      Read guide →
    </a>
  </div>

  <!--
    All three slots are rendered up-front so their Alpine data +
    persisted state hydrate on page load; visibility is controlled by
    `isSlotActive(slotId)` from the wrapper. This avoids the x-model
    hydration race that a purely dynamic template x-for would trigger
    on ClientRouter swaps.
  -->
  <div class="space-y-6">
    <TrainingCalcSlot slotId="primary" />

    <div x-show="isSlotActive('slot-2')" x-cloak>
      <TrainingCalcSlot slotId="slot-2" removable />
    </div>

    <div x-show="isSlotActive('slot-3')" x-cloak>
      <TrainingCalcSlot slotId="slot-3" removable />
    </div>
  </div>

  <!-- Add-another button — hidden once we hit MAX_SLOTS. -->
  <div x-show="canAddMore" x-cloak class="mt-6 flex justify-center">
    <button
      type="button"
      @click="addSlot()"
      class="inline-flex items-center gap-2 rounded border-2 border-dashed border-accent-violet/40 bg-accent-violet/5 px-5 py-3 text-[12px] font-medium text-accent-violet transition-colors hover:border-accent-violet hover:bg-accent-violet/10"
    >
      <span class="text-[16px] leading-none" aria-hidden="true">+</span>
      <span>Add another calculator</span>
    </button>
  </div>

  <!-- Cap-reached hint (only appears when 3 slots are open). -->
  <p
    x-show="!canAddMore"
    x-cloak
    class="mt-6 text-center text-[10px] uppercase tracking-wider text-text-tertiary"
  >
    Maximum of <span x-text="MAX_SLOTS"></span> calculators reached
  </p>
</div>
