---
/**
 * Leveling Calculator — tells the user how many of a chosen creature
 * they need to kill (or how much raw exp) to reach a target level.
 * Auto-fills current level + total exp from the Character Sheet so the
 * only real input is the target.
 *
 * Modifiers are toggle pills (violet when active), stacking
 * multiplicatively. A live "×N.NN" badge updates as pills toggle.
 */
---

<div x-data="levelingTab">
  <div class="flex items-center justify-between gap-4">
    <h2 class="text-[14px] font-medium tracking-wide text-text-primary">Leveling Calculator</h2>
    <span
      x-show="currentLevel > 0"
      x-cloak
      class="text-[10px] uppercase tracking-[0.1em] text-text-tertiary"
    >
      Level: <span x-text="currentLevel" class="text-text-secondary"></span>
    </span>
  </div>

  <!-- Empty state: no character / level 0 -->
  <div
    x-show="!currentLevel || currentLevel <= 0"
    class="mt-6 rounded border border-dashed border-border-subtle bg-bg-sunken p-6 text-center text-[12px] text-text-secondary"
  >
    Set your level and experience in your
    <a href="#character-sheet" class="text-accent-violet underline">Character Sheet</a>
    to use the Leveling Calculator.
  </div>

  <!-- Main content -->
  <div x-show="currentLevel > 0" x-cloak class="mt-6 space-y-6">
    <!-- Inputs -->
    <div class="grid grid-cols-1 gap-3 md:grid-cols-3">
      <label class="block">
        <span class="mb-1 block text-[10px] uppercase tracking-wider text-text-tertiary">Current level</span>
        <input
          type="number"
          readonly
          :value="currentLevel"
          class="w-full cursor-not-allowed rounded border border-border-subtle bg-bg-sunken px-3 py-1.5 text-[12px] text-text-secondary"
        />
        <span class="mt-1 block text-[10px] text-text-tertiary">From Character Sheet</span>
      </label>

      <label class="block">
        <span class="mb-1 block text-[10px] uppercase tracking-wider text-text-tertiary">Target level</span>
        <input
          type="number"
          min="2"
          step="1"
          x-model.number="targetLevel"
          @input.debounce.250ms="save()"
          placeholder="—"
          class="w-full rounded border border-border-subtle bg-bg-sunken px-3 py-1.5 text-[12px] text-text-primary focus:border-accent-violet focus:outline-none"
        />
      </label>

      <label class="block">
        <span class="mb-1 block text-[10px] uppercase tracking-wider text-text-tertiary">Creature</span>
        <select
          x-model="creatureName"
          @change="save()"
          class="w-full rounded border border-border-subtle bg-bg-sunken px-3 py-1.5 text-[12px] text-text-primary focus:border-accent-violet focus:outline-none"
        >
          <option value="">Select creature</option>
          <template x-for="c in LEVELING_CREATURES" :key="c.name">
            <option
              :value="c.name"
              x-text="`${c.name} — ${c.range.min}-${c.range.max === 9999 ? '∞' : c.range.max}`"
            ></option>
          </template>
        </select>
      </label>
    </div>

    <!-- Modifiers (toggle pills) -->
    <div class="border-t border-border-subtle pt-4">
      <div class="flex flex-wrap items-center gap-2">
        <span class="mr-1 text-[10px] uppercase tracking-wider text-text-tertiary">Modifiers</span>

        <button
          type="button"
          @click="toggleModifier('xpBoost')"
          class="rounded-full px-3 py-1 text-[11px] font-medium transition-colors"
          :class="modifiers.xpBoost
            ? 'is-active'
            : 'border border-border-subtle bg-bg-sunken text-text-secondary hover:border-border-emphasis hover:text-text-primary'"
        >
          +50% XP Boost
        </button>

        <button
          type="button"
          @click="toggleModifier('staminaBonus')"
          class="rounded-full px-3 py-1 text-[11px] font-medium transition-colors"
          :class="modifiers.staminaBonus
            ? 'is-active'
            : 'border border-border-subtle bg-bg-sunken text-text-secondary hover:border-border-emphasis hover:text-text-primary'"
        >
          +50% Stamina
        </button>

        <button
          type="button"
          @click="toggleModifier('doubleXp')"
          class="rounded-full px-3 py-1 text-[11px] font-medium transition-colors"
          :class="modifiers.doubleXp
            ? 'is-active'
            : 'border border-border-subtle bg-bg-sunken text-text-secondary hover:border-border-emphasis hover:text-text-primary'"
        >
          +100% Double XP
        </button>

        <button
          type="button"
          @click="toggleModifier('boostedCreature')"
          class="rounded-full px-3 py-1 text-[11px] font-medium transition-colors"
          :class="modifiers.boostedCreature
            ? 'is-active'
            : 'border border-border-subtle bg-bg-sunken text-text-secondary hover:border-border-emphasis hover:text-text-primary'"
        >
          +100% Boosted Creature
        </button>

        <!-- Live multiplier badge — pushes to the right -->
        <span
          x-show="multiplier > 1"
          x-cloak
          class="ml-auto rounded border border-accent-cyan/40 bg-accent-cyan/10 px-2 py-1 text-[11px] font-mono text-accent-cyan"
        >
          ×<span x-text="multiplier.toFixed(2)"></span>
        </span>
      </div>
    </div>

    <!-- Calculate button -->
    <div class="flex items-center gap-3 border-t border-border-subtle pt-4">
      <button
        type="button"
        @click="onCalculate()"
        class="rounded px-5 py-2 text-[12px] font-medium transition-opacity hover:opacity-90"
        :class="isValid ? 'is-active' : 'border border-border-subtle bg-bg-sunken text-text-secondary'"
      >
        <span x-text="showResults ? 'Recalculate' : 'Calculate'"></span>
      </button>
      <span
        x-show="!showResults && !isValid"
        class="text-[11px] text-text-tertiary"
      >
        Set a target level and pick a creature.
      </span>
      <span
        x-show="showResults && !isValid"
        x-cloak
        class="text-[11px] text-danger"
        x-text="fieldError"
      ></span>
    </div>

    <!-- Results -->
    <div x-show="showResults && isValid && result" x-cloak class="space-y-4">
      <!-- Main result: creature count -->
      <article class="rounded-md border-2 border-accent-violet/40 bg-bg-sunken p-6 text-center">
        <h3 class="text-[10px] uppercase tracking-wider text-accent-violet">
          To reach level <span x-text="targetLevel"></span> you need
        </h3>
        <p class="mt-2">
          <span
            class="text-[36px] font-semibold text-accent-cyan"
            x-text="result?.creaturesNeeded.toLocaleString() ?? '0'"
          ></span>
          <span class="ml-2 text-[16px] text-text-primary" x-text="creatureName"></span>
        </p>
        <p class="mt-2 text-[11px] text-text-tertiary">
          At
          <span class="text-text-secondary" x-text="result?.effectiveExpPerKill.toLocaleString(undefined, { maximumFractionDigits: 0 }) ?? '0'"></span>
          exp/kill
          <span x-show="multiplier > 1" x-cloak>
            (base <span x-text="selectedCreature?.baseExp.toLocaleString() ?? '0'"></span> × <span x-text="multiplier.toFixed(2)"></span>)
          </span>
        </p>
      </article>

      <!-- Raw exp number -->
      <article class="rounded-md border border-border-subtle bg-bg-sunken p-4">
        <div class="flex items-baseline justify-between gap-3">
          <h3 class="text-[12px] font-medium text-text-primary">
            Or in raw experience
          </h3>
          <span class="text-[10px] uppercase tracking-wider text-text-tertiary">
            Independent of creature
          </span>
        </div>
        <p class="mt-2 text-[12px] leading-relaxed text-text-secondary">
          You need
          <span class="font-mono font-semibold text-accent-cyan" x-text="result?.expRemaining.toLocaleString() ?? '0'"></span>
          more experience points to go from level
          <span class="text-text-primary" x-text="currentLevel"></span>
          to
          <span class="text-text-primary" x-text="targetLevel"></span>.
        </p>
      </article>
    </div>
  </div>
</div>
