---
/**
 * One instance of the Training Calculator (Exercise Weapons). Rendered
 * 1 to 3 times on the Training tab so the player can compare training
 * plans across different characters side by side.
 *
 * Each slot is fully independent: its own vocation, skill, inputs,
 * modifiers, and results. State is persisted per slot in localStorage
 * via `trainingTab(slotId)`.
 *
 * Props:
 *   - slotId: unique key that scopes this slot's Alpine instance and
 *     localStorage key. "primary" is the always-visible first slot;
 *     "slot-2" and "slot-3" are optional user-added extras.
 *   - removable: when true, shows an X button that dispatches
 *     `training-slot:remove` so the parent trainingSlots wrapper can
 *     retire this slot. Never true for "primary".
 */
interface Props {
  slotId: string;
  removable?: boolean;
}
const { slotId, removable = false } = Astro.props;
---

<div
  class="rounded-md border border-border-subtle bg-bg-surface p-6"
  x-data={`trainingTab('${slotId}')`}
>
  {removable && (
    <div class="mb-3 flex justify-end">
      <button
        type="button"
        @click={`$dispatch('training-slot:remove', { slotId: '${slotId}' })`}
        class="inline-flex items-center gap-1 rounded border border-border-subtle bg-bg-sunken px-2 py-1 text-[10px] text-text-secondary transition-colors hover:border-danger hover:text-danger"
        aria-label="Remove this calculator"
      >
        <span aria-hidden="true">✕</span>
        <span>Remove this calculator</span>
      </button>
    </div>
  )}

  <!-- Vocation dropdown — always visible; nothing else shows until picked. -->
  <div>
    <label class="block max-w-xs">
      <span class="mb-1 block text-[10px] uppercase tracking-wider text-text-tertiary">Vocation</span>
      <select
        x-model="vocation"
        @change="onVocationChange()"
        class="w-full rounded border bg-bg-sunken px-3 py-1.5 text-[12px] capitalize text-text-primary focus:border-accent-violet focus:outline-none"
        :class="fieldErrors.vocation && showResults ? 'border-danger' : 'border-border-subtle'"
      >
        <option value="">Select vocation</option>
        <template x-for="v in VOCATIONS" :key="v">
          <option :value="v" x-text="v" class="capitalize"></option>
        </template>
      </select>
    </label>
  </div>

  <!-- Main content — hidden until vocation is picked -->
  <div x-show="vocation" x-cloak class="mt-6 space-y-6">
    <!-- Inputs grid -->
    <div class="grid grid-cols-1 gap-3 md:grid-cols-2 lg:grid-cols-4">
      <label class="block">
        <span class="mb-1 block text-[10px] uppercase tracking-wider text-text-tertiary">Skill to train</span>
        <select
          x-model="skill"
          @change="onSkillChange()"
          class="w-full rounded border bg-bg-sunken px-3 py-1.5 text-[12px] text-text-primary focus:border-accent-violet focus:outline-none"
          :class="fieldErrors.skill && showResults ? 'border-danger' : 'border-border-subtle'"
        >
          <option value="">Select skill</option>
          <template x-for="t in availableSkills" :key="t.skill">
            <option :value="t.skill" x-text="t.skill"></option>
          </template>
        </select>
        <span
          x-show="fieldErrors.skill && showResults"
          x-cloak
          class="mt-1 block text-[10px] text-danger"
          x-text="fieldErrors.skill"
        ></span>
      </label>

      <label class="block">
        <span class="mb-1 block text-[10px] uppercase tracking-wider text-text-tertiary">Current skill</span>
        <input
          type="number"
          min="0"
          step="1"
          x-model.number="currentSkill"
          @input.debounce.250ms="onCurrentSkillChange()"
          placeholder="—"
          class="w-full rounded border bg-bg-sunken px-3 py-1.5 text-[12px] text-text-primary focus:border-accent-violet focus:outline-none"
          :class="fieldErrors.currentSkill && showResults ? 'border-danger' : 'border-border-subtle'"
        />
        <span
          x-show="fieldErrors.currentSkill && showResults"
          x-cloak
          class="mt-1 block text-[10px] text-danger"
          x-text="fieldErrors.currentSkill"
        ></span>
      </label>

      <label class="block">
        <span
          class="mb-1 block text-[10px] uppercase tracking-wider text-text-tertiary"
          title="Matches the in-game 'You have X.XX% to go' line"
        >% to go</span>
        <input
          type="number"
          min="0"
          max="100"
          step="0.01"
          x-model.number="pctToGo"
          @input.debounce.250ms="onPctChange()"
          @blur="onPctChange()"
          placeholder="0–100"
          class="w-full rounded border bg-bg-sunken px-3 py-1.5 text-[12px] text-text-primary focus:border-accent-violet focus:outline-none"
          :class="fieldErrors.pctToGo && showResults ? 'border-danger' : 'border-border-subtle'"
        />
        <span
          x-show="fieldErrors.pctToGo && showResults"
          x-cloak
          class="mt-1 block text-[10px] text-danger"
          x-text="fieldErrors.pctToGo"
        ></span>
      </label>

      <label class="block">
        <span class="mb-1 block text-[10px] uppercase tracking-wider text-text-tertiary">Target skill</span>
        <input
          type="number"
          min="1"
          step="1"
          x-model.number="targetSkill"
          @input.debounce.250ms="save()"
          placeholder="—"
          class="w-full rounded border bg-bg-sunken px-3 py-1.5 text-[12px] text-text-primary focus:border-accent-violet focus:outline-none"
          :class="fieldErrors.targetSkill && showResults ? 'border-danger' : 'border-border-subtle'"
        />
        <span
          x-show="fieldErrors.targetSkill && showResults"
          x-cloak
          class="mt-1 block text-[10px] text-danger"
          x-text="fieldErrors.targetSkill"
        ></span>
      </label>
    </div>

    <!-- Skill warning (e.g. Knight Magic) -->
    <p
      x-show="selectedSkillData?.warning"
      x-cloak
      class="rounded border border-gold/30 bg-gold/5 px-3 py-2 text-[11px] leading-relaxed text-gold"
    >
      <span aria-hidden="true">⚠</span>
      <span x-text="selectedSkillData?.warning"></span>
    </p>

    <!-- Modifiers + market price -->
    <div class="flex flex-wrap items-center gap-x-5 gap-y-3 border-t border-border-subtle pt-4 text-[11px] text-text-secondary">
      <label class="flex cursor-pointer items-center gap-2">
        <input
          type="checkbox"
          x-model="doubleEvent"
          @change="save()"
          class="h-4 w-4 rounded border-border-subtle bg-bg-sunken accent-accent-violet"
        />
        <span>Double Exp/Skill event</span>
      </label>

      <label class="flex cursor-pointer items-center gap-2">
        <input
          type="checkbox"
          x-model="privateDummy"
          @change="save()"
          class="h-4 w-4 rounded border-border-subtle bg-bg-sunken accent-accent-violet"
        />
        <span>Private dummy</span>
      </label>

      <label class="flex items-center gap-2">
        <span>Loyalty</span>
        <select
          x-model.number="loyalty"
          @change="save()"
          class="rounded border border-border-subtle bg-bg-sunken px-2 py-1 text-[11px] text-text-primary focus:border-accent-violet focus:outline-none"
        >
          <template x-for="opt in LOYALTY_OPTIONS" :key="opt">
            <option :value="opt" x-text="`${opt}%`"></option>
          </template>
        </select>
      </label>

      <label class="flex cursor-pointer items-center gap-2">
        <input
          type="checkbox"
          x-model="tcOverThreshold"
          @change="save()"
          class="h-4 w-4 rounded border-border-subtle bg-bg-sunken accent-accent-violet"
        />
        <span>Tibia Coin above 14,000 gp</span>
      </label>
    </div>

    <!-- Calculate button row -->
    <div class="flex items-center gap-3 border-t border-border-subtle pt-4">
      <button
        type="button"
        @click="calculate()"
        class="rounded px-5 py-2 text-[12px] font-medium transition-opacity hover:opacity-90"
        :class="isValid ? 'is-active' : 'border border-border-subtle bg-bg-sunken text-text-secondary'"
      >
        <span x-text="showResults ? 'Recalculate' : 'Calculate'"></span>
      </button>
      <span
        x-show="showResults && !isValid"
        x-cloak
        class="text-[11px] text-danger"
      >
        Fix the highlighted fields above.
      </span>
      <span
        x-show="!showResults"
        class="text-[11px] text-text-tertiary"
      >
        Fill the inputs and press Calculate to see your training plan.
      </span>
    </div>

    <!-- Results -->
    <div x-show="showResults && isValid" x-cloak class="space-y-4">
      <!-- 3 single-weapon-type cards (alternatives) -->
      <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
        <template x-for="card in cards" :key="card.type">
          <article class="rounded-md border border-border-subtle bg-bg-sunken p-5">
            <h3 class="whitespace-nowrap text-[14px] font-semibold text-text-primary" x-text="card.label"></h3>
            <p class="whitespace-nowrap text-[10px] uppercase tracking-wider text-text-tertiary" x-text="`${fmtCount(card.charges)} charges`"></p>

            <dl class="mt-4 space-y-2 text-[12px]">
              <div class="flex items-baseline justify-between gap-2">
                <dt class="whitespace-nowrap text-text-tertiary">Weapons</dt>
                <dd class="text-right font-semibold text-text-primary" x-text="fmtCount(card.result.weapons)"></dd>
              </div>
              <div class="flex items-baseline justify-between gap-2">
                <dt class="whitespace-nowrap text-text-tertiary" x-text="tcOverThreshold ? 'Cost (gp)' : 'Cost (TC)'"></dt>
                <dd
                  class="text-right"
                  :class="tcOverThreshold ? 'text-gold' : 'text-text-primary'"
                  x-text="tcOverThreshold
                    ? `${fmtGold(card.result.costGP)} gp`
                    : `${fmtCount(card.result.costTC)} TC`"
                ></dd>
              </div>
              <div class="flex items-baseline justify-between gap-2">
                <dt class="whitespace-nowrap text-text-tertiary">Time</dt>
                <dd class="text-right text-text-secondary" x-text="fmtHours(card.result.hours)"></dd>
              </div>
              <div class="border-t border-border-subtle pt-2">
                <p class="text-[12px] text-text-secondary">
                  Ending at
                  <span class="font-semibold text-accent-cyan">skill <span x-text="card.result.endLevel"></span></span>
                </p>
                <p class="mt-0.5 whitespace-nowrap text-[10px] text-text-tertiary">
                  <span x-text="fmtPctToNext(card.result.endPct)"></span>% remaining <span class="font-bold text-text-secondary">→</span> <span x-text="card.result.endLevel + 1"></span>
                </p>
              </div>
            </dl>
          </article>
        </template>
      </div>

    </div>
  </div>
</div>
