---
---

<div class="rounded-md border border-border-subtle bg-bg-surface p-6">
  <div class="flex items-center justify-between gap-4">
    <h2 class="text-[14px] font-medium tracking-wide text-text-primary">Loot Split</h2>
    <button
      type="button"
      @click="toggleHistoryOpen()"
      :disabled="history.length === 0"
      class="rounded border px-3 py-1 text-[10px] uppercase tracking-[0.1em] transition-colors disabled:cursor-not-allowed disabled:opacity-40"
      :class="history.length === 0 ? 'border-border-subtle bg-bg-sunken text-text-tertiary' : (historyOpen ? 'border-accent-violet bg-accent-violet/10 text-accent-violet' : 'border-border-subtle bg-bg-sunken text-text-secondary hover:border-accent-violet hover:text-accent-violet')"
    >
      Hunt History (<span x-text="history.length"></span>/15)
    </button>
  </div>

  <div class="mt-6 space-y-5">
    <!-- Textarea + actions -->
    <div>
      <label class="block">
        <span class="mb-1 block text-[10px] uppercase tracking-wider text-text-tertiary">
          Hunt Analyzer log
        </span>
        <textarea
          id="loot-log"
          x-model="rawLog"
          @input.debounce.500ms="save()"
          @keydown.enter.ctrl.prevent="calculate()"
          @keydown.enter.meta.prevent="calculate()"
          rows="6"
          spellcheck="false"
          placeholder="Paste your Party Hunt Analyzer log here (right-click on the analyzer in-game → 'Copy to Clipboard'). Ctrl+Enter calculates."
          class="w-full rounded border border-border-subtle bg-bg-sunken px-3 py-2 font-mono text-[11px] leading-relaxed text-text-primary placeholder:text-text-tertiary focus:border-accent-violet focus:outline-none"
        ></textarea>
      </label>

      <div class="mt-2 flex flex-wrap items-center gap-2">
        <button
          type="button"
          @click="calculate()"
          :disabled="!rawLog.trim()"
          class="rounded px-5 py-2 text-[12px] font-medium transition-opacity hover:opacity-90 disabled:cursor-not-allowed disabled:opacity-40"
          :class="rawLog.trim() ? 'is-active' : 'border border-border-subtle bg-bg-sunken text-text-secondary'"
        >
          Calculate split
        </button>
        <span x-show="rawLog.trim()" class="text-[10px] text-text-tertiary">or press Ctrl+Enter</span>
        <button
          type="button"
          @click="clearLog()"
          x-show="rawLog.trim() || currentHunt"
          x-cloak
          class="rounded border border-border-subtle bg-bg-sunken px-3 py-2 text-[11px] text-text-secondary transition-colors hover:border-border-emphasis hover:text-text-primary"
        >
          Clear
        </button>
        <span
          x-show="parseError"
          x-cloak
          class="text-[11px] text-danger"
          x-text="parseError"
        ></span>
      </div>
    </div>

    <!-- Results: Hunt summary, Transfers, Per-Player Breakdown -->
    <div x-show="currentHunt && transfers !== null" x-cloak class="space-y-4">
      <!-- Hunt summary -->
      <article class="rounded-md border border-border-subtle bg-bg-sunken p-4">
        <h3 class="text-[12px] font-medium text-text-primary">Hunt summary</h3>
        <dl class="mt-3 grid grid-cols-3 gap-3 text-[12px]">
          <div>
            <dt class="text-[10px] uppercase tracking-wider text-text-tertiary">Players</dt>
            <dd class="mt-0.5 font-semibold text-text-primary" x-text="currentHunt.players.length"></dd>
          </div>
          <div>
            <dt class="text-[10px] uppercase tracking-wider text-text-tertiary">Duration</dt>
            <dd class="mt-0.5 font-semibold text-text-primary" x-text="currentHunt.duration || '—'"></dd>
          </div>
          <div class="text-right">
            <dt class="text-[10px] uppercase tracking-wider text-text-tertiary">Total balance</dt>
            <dd class="mt-0.5 font-semibold text-gold" x-text="`${formatNumber(currentHunt.totalBalance)} gp`"></dd>
          </div>
        </dl>
      </article>

      <!-- Transfers -->
      <article
        x-show="currentHunt.players.length >= 2"
        x-cloak
        class="rounded-md border-2 border-accent-violet/40 bg-bg-sunken p-4"
        style="background-image: linear-gradient(135deg, rgba(155,138,251,0.06), rgba(93,202,232,0.03));"
      >
        <div class="flex flex-wrap items-center justify-between gap-3">
          <h3 class="text-[13px] font-medium text-accent-violet">Transfers</h3>
          <div class="flex flex-wrap items-center gap-2">
            <button
              type="button"
              @click="copyToDiscord()"
              class="rounded border border-border-subtle bg-bg-sunken px-3 py-1.5 text-[11px] font-medium text-text-secondary transition-colors hover:border-accent-violet hover:text-accent-violet"
              :class="copied && 'border-success text-success hover:border-success hover:text-success'"
            >
              <span x-show="!copied">Copy summary</span>
              <span x-show="copied" x-cloak>✓ Copied</span>
            </button>
            <button
              type="button"
              @click="copyOriginalLog()"
              :disabled="!currentRawLog"
              class="rounded border border-border-subtle bg-bg-sunken px-3 py-1.5 text-[11px] font-medium text-text-secondary transition-colors hover:border-accent-violet hover:text-accent-violet disabled:cursor-not-allowed disabled:opacity-40"
              :class="copiedLog && 'border-success text-success hover:border-success hover:text-success'"
            >
              <span x-show="!copiedLog">Copy original log</span>
              <span x-show="copiedLog" x-cloak>✓ Copied</span>
            </button>
          </div>
        </div>

        <ul x-show="transfers.length > 0" x-cloak class="mt-3 space-y-2 text-[12px]">
          <template x-for="(t, i) in transfers" :key="i">
            <li class="flex items-baseline gap-3 border-t border-border-subtle pt-2 first:border-0 first:pt-0">
              <span class="font-semibold text-text-primary" x-text="t.from"></span>
              <span class="font-bold text-text-secondary" aria-hidden="true">→</span>
              <span class="font-semibold text-text-primary" x-text="t.to"></span>
              <span class="ml-auto whitespace-nowrap font-semibold text-gold" x-text="`${formatNumber(t.amount)} gp`"></span>
            </li>
          </template>
        </ul>

        <p
          x-show="transfers.length === 0"
          x-cloak
          class="mt-3 text-[11px] text-text-tertiary"
        >
          All players already had a fair share — no transfers needed.
        </p>
      </article>

      <!-- Per-Player Breakdown -->
      <article class="rounded-md border border-border-subtle bg-bg-sunken p-4">
        <h3 class="text-[12px] font-medium text-text-primary">Per-Player Breakdown</h3>
        <div class="mt-3 overflow-x-auto">
          <table class="w-full min-w-[480px] text-[11px]">
            <thead class="text-[10px] uppercase tracking-wider text-text-tertiary">
              <tr class="border-b border-border-subtle">
                <th class="py-2 pr-4 text-left font-medium">Player</th>
                <th class="py-2 pr-4 text-right font-medium">Loot</th>
                <th class="py-2 pr-4 text-right font-medium">Supplies</th>
                <th class="py-2 pr-4 text-right font-medium">Balance</th>
                <th class="py-2 pr-4 text-right font-medium">Damage</th>
                <th class="py-2 text-right font-medium">Healing</th>
              </tr>
            </thead>
            <tbody>
              <template x-for="p in currentHunt.players" :key="p.name">
                <tr class="border-b border-border-subtle/50 last:border-0">
                  <td class="py-1.5 pr-4 font-semibold text-text-primary" x-text="p.name"></td>
                  <td class="py-1.5 pr-4 text-right text-text-secondary" x-text="formatNumber(p.loot)"></td>
                  <td class="py-1.5 pr-4 text-right text-text-secondary" x-text="formatNumber(p.supplies)"></td>
                  <td
                    class="py-1.5 pr-4 text-right font-semibold"
                    :class="p.balance >= 0 ? 'text-success' : 'text-danger'"
                    x-text="formatNumber(p.balance)"
                  ></td>
                  <td class="py-1.5 pr-4 text-right text-text-secondary" x-text="formatNumber(p.damage)"></td>
                  <td class="py-1.5 text-right text-text-secondary" x-text="formatNumber(p.healing)"></td>
                </tr>
              </template>
            </tbody>
          </table>
        </div>
      </article>
    </div>
  </div>
</div>
