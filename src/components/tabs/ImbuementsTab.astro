---
---

<div
  x-data="imbuementsTab"
  class="rounded-md border border-border-subtle bg-bg-surface p-6"
>
  <!-- Sections only. The Imbuements header (title + description) lives in
       the main column tab-content area (see index.astro), so it shares the
       SAME width and SAME mt-4 gap from the tabs as the Training Calculator
       and Loot Split cards. This rectangle is the wide "leg" of the natural
       L: narrow header above (in main column), full-width sections here. -->
  <div class="space-y-12">
    <template x-for="cat in CATEGORIES" :key="cat.id">
      <section>
        <header class="flex items-baseline justify-between border-b border-border-subtle pb-2">
          <h3 class="text-[12px] font-medium uppercase tracking-wider text-text-secondary" x-text="cat.label"></h3>
          <span class="text-[10px] text-text-tertiary">
            <span x-text="cat.imbuements.length"></span> imbuements
          </span>
        </header>

        <!--
          3 cols at lg+ → ~390px per card and uniform rows for every
          category that has 3 or 6 imbuements.
        -->
        <div class="mt-5 grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
          <template x-for="imb in cat.imbuements" :key="imb.name">
            <article
              class="flex flex-col rounded-lg border-2 border-accent-violet/40 bg-bg-sunken p-6"
              style="background-image: linear-gradient(135deg, rgba(155,138,251,0.08), rgba(93,202,232,0.04));"
            >
              <!-- Centered header -->
              <header class="text-center">
                <h4 class="text-[17px] font-semibold leading-tight text-text-primary" x-text="imb.name"></h4>
                <p class="mt-1 text-[11px] uppercase tracking-wider text-text-tertiary" x-text="imb.affects"></p>
              </header>

              <!--
                Centered sprite slot — 96x96 placeholder. When CipSoft fansite
                assets land, swap the inner div for an <img /> at the same
                dimensions and the layout stays identical.
              -->
              <div class="mt-5 flex justify-center">
                <div
                  class="grid h-24 w-24 place-items-center rounded-md border border-border-subtle bg-bg-primary text-[10px] uppercase tracking-[0.1em] text-text-tertiary"
                  aria-hidden="true"
                >
                  Sprite
                </div>
              </div>

              <!--
                Tier buttons — one line guaranteed (whitespace-nowrap), bigger
                font and padding now that cards have ~450px to breathe.
              -->
              <div class="mt-6 grid grid-cols-3 gap-2">
                <template x-for="tier in TIERS" :key="tier">
                  <button
                    type="button"
                    class="whitespace-nowrap rounded-md border px-3 py-2 text-[12px] font-medium transition-colors"
                    :class="tierFor(imb) === tier ? 'is-active' : 'border-border-subtle bg-bg-primary text-text-secondary hover:border-border-emphasis hover:text-text-primary'"
                    :aria-pressed="tierFor(imb) === tier"
                    @click="setTier(imb, tier)"
                    x-text="tierLabel(tier)"
                  ></button>
                </template>
              </div>

              <!--
                Bonus — stacked vertically (label on top, value below) so
                long copies like Strike's "+5% crit chance · +40% damage"
                or the Skill Boost imbuements never overflow horizontally.
                Same MATERIALS-style label pattern keeps cards uniform.
              -->
              <div class="mt-6">
                <p class="mb-2 text-[10px] uppercase tracking-wider text-text-tertiary">Bonus</p>
                <p class="text-right text-[13px] font-medium text-accent-cyan" x-text="imb.bonus[tierFor(imb)]"></p>
              </div>

              <!--
                Materials section — at the imbuing shrine you pay either with
                this material list OR with N gold tokens (the "or" divider
                makes the alternative payment explicit).
              -->
              <div class="mt-4 border-t border-accent-violet/20 pt-4">
                <p class="mb-2 text-[10px] uppercase tracking-wider text-text-tertiary">Materials</p>
                <ul class="space-y-2 text-[13px]">
                  <template x-for="ing in imb.ingredients[tierFor(imb)]" :key="ing.name">
                    <li class="flex items-baseline justify-between gap-3">
                      <span class="text-text-secondary" x-text="ing.name"></span>
                      <span class="shrink-0 font-semibold text-text-primary">
                        ×<span x-text="ing.qty"></span>
                      </span>
                    </li>
                  </template>
                </ul>

                <div class="my-3 flex items-center gap-2 text-[10px] uppercase tracking-[0.2em] text-text-tertiary">
                  <span class="h-px flex-1 bg-border-subtle"></span>
                  <span>or</span>
                  <span class="h-px flex-1 bg-border-subtle"></span>
                </div>

                <div class="flex items-baseline justify-between gap-3 text-[13px]">
                  <span class="text-text-secondary">Gold Tokens</span>
                  <span class="shrink-0 font-semibold text-gold">
                    ×<span x-text="GOLD_TOKENS[tierFor(imb)]"></span>
                  </span>
                </div>
              </div>

              <!-- Cost — gp fee at the imbuing shrine, separate from materials. -->
              <div class="mt-auto flex items-baseline justify-between gap-3 border-t border-accent-violet/20 pt-4">
                <span class="text-[10px] uppercase tracking-wider text-text-tertiary">Cost</span>
                <span class="text-[14px] font-semibold text-gold">
                  <span x-text="formatGoldShort(GOLD_FEE[tierFor(imb)])"></span> gp
                </span>
              </div>

              <!-- Optional caveat (e.g. Knock/Punch source uncertainty) -->
              <p
                x-show="imb.note"
                x-cloak
                class="mt-3 border-t border-accent-violet/20 pt-2 text-[9px] leading-relaxed text-text-tertiary"
                x-text="imb.note"
              ></p>
            </article>
          </template>
        </div>
      </section>
    </template>
  </div>
</div>
