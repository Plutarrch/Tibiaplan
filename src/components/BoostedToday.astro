---
/**
 * Boosted-today widget shown in the Header. Hidden on small screens to keep
 * the mobile header compact. The actual fetch + countdown logic lives in
 * src/lib/boostedToday.ts (registered as Alpine x-data="boostedToday").
 *
 * The whole widget hides until `ready === true` so we don't flash empty
 * placeholders while the API call resolves.
 */
---

<div
  x-data="boostedToday"
  x-show="ready"
  x-cloak
  class="hidden items-center gap-3 text-[11px] md:flex"
>
  <!-- Boosted creature -->
  <a
    :href="creature.wikiUrl"
    target="_blank"
    rel="noopener noreferrer"
    class="flex items-center gap-2 rounded border border-border-subtle bg-bg-sunken px-2 py-1 transition-colors hover:border-accent-violet"
    :title="`Boosted creature: ${creature.name}`"
  >
    <img
      :src="creature.image"
      :alt="creature.name"
      class="h-9 w-9 object-contain"
      loading="lazy"
      decoding="async"
    />
    <span class="flex min-w-0 flex-col leading-tight">
      <span class="text-[9px] uppercase tracking-wider text-text-tertiary">Creature</span>
      <span class="block max-w-[140px] truncate font-medium text-text-primary" x-text="creature.name"></span>
    </span>
  </a>

  <!-- Boosted boss -->
  <a
    :href="boss.wikiUrl"
    target="_blank"
    rel="noopener noreferrer"
    class="flex items-center gap-2 rounded border border-border-subtle bg-bg-sunken px-2 py-1 transition-colors hover:border-accent-violet"
    :title="`Boosted boss: ${boss.name}`"
  >
    <img
      :src="boss.image"
      :alt="boss.name"
      class="h-9 w-9 object-contain"
      loading="lazy"
      decoding="async"
    />
    <span class="flex min-w-0 flex-col leading-tight">
      <span class="text-[9px] uppercase tracking-wider text-text-tertiary">Boss</span>
      <span class="block max-w-[140px] truncate font-medium text-text-primary" x-text="boss.name"></span>
    </span>
  </a>

  <!--
    "Next change" pill lives in its own component (NextChange.astro) and
    sits AFTER Rashid in the header, since Creature / Boss / Rashid all
    rotate at the same server save time. We still keep the countdown logic
    inside this Alpine state too — refreshCountdown() invalidates the
    boosted-pair cache as the timer crosses zero.
  -->
</div>
