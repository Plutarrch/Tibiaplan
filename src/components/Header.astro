---
import BoostedToday from "./BoostedToday.astro";
import NextChange from "./NextChange.astro";
import RashidLocation from "./RashidLocation.astro";
---

<header class="sticky top-0 z-10 border-b border-border-subtle bg-bg-surface/85 backdrop-blur">
  <!--
    Centerpiece shield: floats across both rows on desktop and protrudes
    slightly past the bottom of Row 2 — the shield's pointed bottom is
    literally the "V poking out of the second bar" the brand calls for.
    Sized h-24 (96px) so it reads as the dominant brand element instead
    of a corner icon. Mobile reuses the compact left-aligned logo+text
    from before because Row 2 is hidden there, so there's no boundary
    to straddle.
  -->
  <a
    href="/"
    aria-label="TibiaPlan home"
    class="absolute left-1/2 top-[4.5rem] z-20 hidden -translate-x-1/2 -translate-y-1/2 transition-transform hover:scale-105 md:block"
  >
    <img
      src="/TibiaPlanLogo.png"
      alt="TibiaPlan"
      width="96"
      height="96"
      class="h-24 w-24 drop-shadow-[0_4px_12px_rgba(0,0,0,0.5)]"
      loading="eager"
      decoding="async"
    />
  </a>

  <!--
    Row 1: left = hamburger + brand text (and the small logo on mobile);
    right = nav.
  -->
  <div class="mx-auto flex max-w-7xl items-center justify-between gap-4 px-4 py-3">
    <div
      x-data="{ open: false }"
      @keydown.escape.window="open = false"
      class="relative flex items-center gap-3"
    >
      <!--
        Hamburger menu. Click toggles the dropdown; the dropdown closes
        on Escape, on outside click, and on link click.
      -->
      <button
        type="button"
        @click="open = !open"
        :aria-expanded="open"
        aria-label="Open menu"
        aria-controls="primary-menu"
        class="grid h-8 w-8 place-items-center rounded border border-border-subtle bg-bg-sunken text-text-secondary transition-colors hover:border-border-emphasis hover:text-text-primary"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="h-4 w-4"
          aria-hidden="true"
        >
          <line x1="3" y1="6" x2="21" y2="6" />
          <line x1="3" y1="12" x2="21" y2="12" />
          <line x1="3" y1="18" x2="21" y2="18" />
        </svg>
      </button>

      <a href="/" class="flex items-center gap-2 no-underline">
        <img
          src="/TibiaPlanLogo.png"
          alt=""
          width="32"
          height="32"
          class="h-8 w-8 md:hidden"
          loading="eager"
          decoding="async"
        />
        <span class="text-[14px] font-medium tracking-wide text-text-primary">TibiaPlan</span>
      </a>

      <!-- Dropdown menu — positioned absolute directly under the hamburger. -->
      <div
        id="primary-menu"
        x-show="open"
        x-cloak
        x-transition.origin.top.left
        @click.outside="open = false"
        class="absolute left-0 top-full z-30 mt-2 w-56 rounded-md border border-border-subtle bg-bg-surface p-1 shadow-lg shadow-black/40"
      >
        <a
          href="/"
          @click="open = false"
          class="block rounded px-3 py-2 text-[12px] text-text-secondary transition-colors hover:bg-bg-sunken hover:text-text-primary"
        >
          Main Page
        </a>
        <a
          href="/guides"
          @click="open = false"
          class="block rounded px-3 py-2 text-[12px] text-text-secondary transition-colors hover:bg-bg-sunken hover:text-text-primary"
        >
          Guides
        </a>
        <span
          class="tooltip-host relative block cursor-not-allowed rounded px-3 py-2 text-[12px] text-text-tertiary"
          title="Coming soon"
        >
          Destiny Wheel
          <span class="ml-1 text-[9px] uppercase tracking-wider text-text-tertiary/60">soon</span>
        </span>
        <a
          href="/advertise"
          @click="open = false"
          class="block rounded px-3 py-2 text-[12px] text-text-secondary transition-colors hover:bg-bg-sunken hover:text-text-primary"
        >
          Advertise
        </a>
        <a
          href="/about"
          @click="open = false"
          class="block rounded px-3 py-2 text-[12px] text-text-secondary transition-colors hover:bg-bg-sunken hover:text-text-primary"
        >
          About
        </a>
      </div>
    </div>

    <nav class="flex items-center gap-2 text-[11px]">
      <button
        type="button"
        class="rounded border border-border-subtle bg-bg-sunken px-3 py-1.5 text-text-secondary transition-colors hover:border-border-emphasis hover:text-text-primary"
        onclick="if (confirm('Reset everything? This clears your character, training inputs, and hunt history.')) { window.dispatchEvent(new CustomEvent('app:reset')); }"
      >
        <span aria-hidden="true">↻</span> Reset
      </button>
      <a
        href="https://discord.gg/NfDrY5GM6y"
        target="_blank"
        rel="noopener noreferrer"
        class="flex items-center gap-1.5 rounded px-3 py-1.5 font-medium text-white transition-opacity hover:opacity-90"
        style="background:#5865F2"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="currentColor"
          class="h-3.5 w-3.5"
          aria-hidden="true"
        >
          <path d="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 0 0 .031.057 19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028 14.09 14.09 0 0 0 1.226-1.994.076.076 0 0 0-.041-.106 13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128 10.2 10.2 0 0 0 .372-.292.074.074 0 0 1 .077-.01c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127 12.299 12.299 0 0 1-1.873.892.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.839 19.839 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.03zM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.956-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.956 2.418-2.157 2.418zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.946 2.418-2.157 2.418Z" />
        </svg>
        Discord
      </a>
      <a
        href="/donate"
        class="is-active rounded px-3 py-1.5 transition-opacity hover:opacity-90"
      >
        <span aria-hidden="true">♥</span> Donate
      </a>
    </nav>
  </div>

  <!--
    Row 2: live status widgets. Creature/Boss anchor left, Rashid + Next
    change anchor right via justify-between. Hidden on mobile.
  -->
  <div class="hidden border-t border-border-subtle/50 md:block">
    <div class="mx-auto flex min-h-[3.25rem] max-w-7xl flex-wrap items-center justify-between gap-4 px-4 py-2">
      <BoostedToday />
      <div class="flex items-center gap-4">
        <RashidLocation />
        <NextChange />
      </div>
    </div>
  </div>
</header>
