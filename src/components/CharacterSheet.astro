---
/**
 * Character Sheet — trimmed down 2026-09-23.
 *
 * Was the busy hub of the home page (blessings, skills, Death Simulator,
 * skull selector, "% to go" per skill, revive flow). The Death Simulator
 * and its dependencies moved to /guides/tibia-death-penalty. What's
 * left is the character "identity" panel:
 *
 *   - Name (populated by Character Search "Use as profile"; editable)
 *   - Vocation sprite (READ-ONLY — driven by the Training calculator's
 *     primary slot vocation OR Character Search "Use as profile").
 *   - Level (input)
 *   - Share XP range hint
 *   - Stamina mini-calc (time to 42:00)
 *
 * The vocation dropdown was removed in favor of the sprite reflecting
 * whatever the user last picked in the primary Training slot or
 * imported via Character Search — a single source of truth from those
 * two entry points, no double-entry.
 */
---

<section
  x-data="characterSheet"
  id="character-sheet"
  class="scroll-mt-20 rounded-md border border-border-subtle bg-bg-surface p-6"
  aria-label="Character Sheet"
>
  <!-- Top bar: Name as the card heading, "Character Sheet" label on the right. -->
  <div class="flex items-center justify-between gap-4">
    <label class="group flex min-w-0 flex-1 items-center gap-3 border-b border-transparent pb-1 hover:border-border-subtle focus-within:border-accent-violet">
      <svg
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2.75"
        stroke-linecap="round"
        stroke-linejoin="round"
        class="h-6 w-6 shrink-0 text-text-tertiary transition-colors group-hover:text-text-secondary group-focus-within:text-accent-violet"
        aria-hidden="true"
        x-show="!name"
      >
        <path d="M17 3a2.85 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z" />
        <path d="m15 5 4 4" />
      </svg>
      <span class="sr-only">Character name</span>
      <input
        type="text"
        x-model="name"
        @input.debounce.300ms="save()"
        placeholder=""
        aria-label="Character name"
        class="min-w-0 flex-1 bg-transparent text-[20px] font-medium text-text-primary placeholder:text-text-tertiary focus:outline-none"
      />
    </label>
    <span class="shrink-0 text-[10px] uppercase tracking-[0.1em] text-text-tertiary">
      Character Sheet
    </span>
  </div>

  <div class="mt-6 grid grid-cols-1 gap-6 md:grid-cols-[auto_minmax(0,1fr)]">
    <!-- LEFT: vocation sprite (identity panel). No action button anymore —
         the Death Simulator moved to /guides/tibia-death-penalty. -->
    <div>
      <div
        class="grid h-[220px] w-[180px] place-items-center rounded border border-border-subtle bg-bg-sunken"
      >
        <img
          :src="vocation ? `/sprites/vocations/${vocation}.png` : '/sprites/vocations/placeholder.png'"
          :alt="vocation || 'No vocation selected'"
          class="h-full w-full object-contain p-3"
          :class="!vocation && 'grayscale opacity-60'"
          style="image-rendering: pixelated;"
          loading="lazy"
          decoding="async"
          onerror="this.style.display='none'"
        />
      </div>
    </div>

    <!-- RIGHT: form fields. Vocation is no longer a dropdown here —
         the sprite on the left reads its value from the Character Sheet
         state, which gets populated by the Training calc primary slot
         or by Character Search "Use as profile". -->
    <div class="min-w-0 space-y-6">
      <!-- Level (Experience removed 2026-09-23 — the reverse
           lookup wasn't earning its keep on the home page). -->
      <div>
        <label class="block max-w-xs">
          <span class="mb-1 block text-[10px] uppercase tracking-wider text-text-tertiary">Level</span>
          <input
            type="number"
            min="1"
            max="5000"
            x-model.number="level"
            @input.debounce.300ms="save()"
            placeholder="—"
            class="w-full rounded border border-border-subtle bg-bg-sunken px-3 py-1.5 text-[12px] text-text-primary focus:border-accent-violet focus:outline-none"
          />
        </label>
      </div>

      <!-- Party exp-share range. Always visible so the tool "reads" as
           present even before the user has typed a Level. Empty state
           uses skeleton bars where the numbers will appear — same
           silhouette as the filled state so nothing shifts when Level
           finally gets typed. -->
      <div class="rounded-md border border-border-subtle bg-bg-sunken px-4 py-3">
        <p class="text-[10px] uppercase tracking-wider text-text-tertiary">
          Party exp-share range
        </p>

        <!-- Filled state: real min — max. -->
        <template x-if="shareRange">
          <div>
            <p class="mt-1 text-[16px] font-semibold text-text-primary">
              <span x-text="shareRange?.min"></span>
              <span class="mx-1 text-text-tertiary">—</span>
              <span x-text="shareRange?.max"></span>
            </p>
            <p class="mt-1 text-[10px] text-text-tertiary">
              Party members outside this range don&apos;t receive shared XP.
            </p>
          </div>
        </template>

        <!-- Empty state: skeleton bars where the numbers will land.
             h-5 roughly matches the leading of the 16px filled numbers,
             so the vertical rhythm doesn't jump when the state flips. -->
        <template x-if="!shareRange">
          <div>
            <div class="mt-1 flex items-center gap-2">
              <span class="block h-5 w-12 rounded bg-border-subtle" aria-hidden="true"></span>
              <span class="text-[16px] text-text-tertiary">—</span>
              <span class="block h-5 w-12 rounded bg-border-subtle" aria-hidden="true"></span>
            </div>
            <p class="mt-1 text-[10px] text-text-tertiary">
              Enter your Level above to see the range.
            </p>
          </div>
        </template>
      </div>

      <!--
        Stamina mini-calc. Owner flagged this for further UX polish
        (2026-09-23) — for now it stays as-is so the sheet still ships
        something useful beyond identity fields.
      -->
      <div>
        <div class="flex items-center justify-between gap-2">
          <h3 class="text-[12px] font-medium text-text-primary">Stamina</h3>
          <span class="text-[10px] text-text-tertiary">How long to 42:00</span>
        </div>

        <div class="mt-2 grid grid-cols-[140px_auto_minmax(0,1fr)] items-end gap-3">
          <label class="block">
            <span class="mb-1 block text-[10px] uppercase tracking-wider text-text-tertiary">
              Current
            </span>
            <input
              type="text"
              inputmode="numeric"
              maxlength="5"
              :value="staminaInput"
              @input="staminaInput = formatStaminaInput($event.target.value)"
              @blur="onStaminaChange()"
              @keydown.enter.prevent="onStaminaChange(); $event.target.blur()"
              placeholder="HH:MM"
              class="w-full rounded border border-border-subtle bg-bg-sunken px-2 py-1 text-[12px] text-text-primary placeholder:text-text-tertiary focus:border-accent-violet focus:outline-none"
            />
          </label>
          <span class="pb-1.5 text-[14px] text-text-tertiary" aria-hidden="true">→</span>
          <div class="min-w-0">
            <span class="mb-1 block text-[10px] uppercase tracking-wider text-text-tertiary">
              Offline needed
            </span>
            <p
              class="truncate text-[14px] font-semibold"
              :class="staminaTimeToMax ? 'text-accent-cyan' : 'text-text-tertiary'"
              x-text="staminaTimeToMax || '—'"
            ></p>
          </div>
        </div>

        <a
          href="/guides/tibia-stamina"
          class="mt-2 block text-[10px] text-text-tertiary transition-colors hover:text-accent-violet"
        >
          Read guide →
        </a>
      </div>
    </div>
  </div>

  <!-- Bottom-right: subtle auto-saved indicator -->
  <div class="mt-4 flex justify-end">
    <span class="text-[9px] uppercase tracking-[0.15em] text-text-tertiary opacity-60">
      auto-saved
    </span>
  </div>
</section>
