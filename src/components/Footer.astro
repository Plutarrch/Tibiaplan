---
const DISCORD_URL = "https://discord.gg/NfDrY5GM6y";
---

<footer class="mt-12 border-t border-border-subtle bg-bg-surface">
  <div class="mx-auto flex max-w-7xl flex-col gap-4 px-4 py-6 sm:flex-row sm:items-center sm:justify-between">
    <p class="text-[10px] leading-relaxed text-text-tertiary sm:max-w-xl">
      Tibia and all related sprites, names, and assets are © CipSoft GmbH.
      This is an unofficial fansite. We are not affiliated with or endorsed by CipSoft.
    </p>

    <nav class="flex flex-wrap items-center gap-x-4 gap-y-1 text-[11px] text-text-secondary">
      <span class="text-[10px] uppercase tracking-wider text-text-tertiary">Contact</span>
      <a
        href={DISCORD_URL}
        target="_blank"
        rel="noopener noreferrer"
        class="transition-colors hover:text-accent-violet"
      >
        Discord
      </a>
      <a
        href="/donate"
        class="transition-colors hover:text-accent-violet"
      >
        Donate
      </a>
      <a
        href="/advertise"
        class="transition-colors hover:text-accent-violet"
      >
        Advertise
      </a>
    </nav>
  </div>
</footer>
